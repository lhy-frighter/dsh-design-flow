{
  "name": "dsh-design-flow",
  "version": "0.3.1",
  "description": "个人 UI 设计工作流插件：ui-design-flow 全流程 + awesome-design-md 素材库 + 子代理评审注入（基于 dsh-oil-ui 骨架）",
  "license": "MIT",
  "author": "oil-oil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oil-oil/dsh-oil-ui.git"
  },
  "homepage": "https://github.com/oil-oil/dsh-oil-ui#readme",
  "bugs": {
    "url": "https://github.com/oil-oil/dsh-oil-ui/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "oil-ui",
    "ui-design"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "LICENSE",
    "README.md",
    "README.en.md",
    "assets/readme",
    "cordis.patch.yml",
    "lib",
    "skills/oil-ui.manifest.json",
    "skills/oil-ui",
    "skills/design-flow",
    "skills/grill-me",
    "skills/react-best-practices"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "pack:plugin": "node scripts/package-plugin.mjs",
    "sync:skill": "node scripts/vendor-oil-ui.mjs skills/oil-ui",
    "vendor:skill": "node scripts/vendor-oil-ui.mjs",
    "build:skill": "node scripts/build-dsh-skill.mjs",
    "export:portable": "node scripts/export-portable.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "acorn": "8.19.0",
    "parse5": "^8.0.1",
    "postcss": "^8.5.30",
    "postcss-value-parser": "^4.2.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "packageManager": "pnpm@10.16.1"
}
